#root { min-height: 100vh; }
.app-shell { min-height: 100vh; background: #050505; padding: 0 17px 105px; max-width: 720px; margin: auto; }
.topbar { height: 68px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #181818; }
.brand { display: flex; align-items: center; gap: 9px; font: 800 18px 'Manrope', sans-serif; letter-spacing: 2.6px; }
.brand-mark { width: 27px; height: 27px; display: grid; place-items: center; border: 1px solid #fff; font-size: 16px; letter-spacing: 0; }
.brand-dot { color: #a5ff72; margin-left: -8px; }
.icon-btn { border: 0; background: #141414; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; }
.hero { padding: 29px 0 23px; }
.hero-overline { display: flex; align-items: center; gap: 7px; font-size: 10px; font-weight: 700; color: #a5ff72; letter-spacing: 1.8px; }
.hero h1 { font: 800 48px/.98 'Manrope', sans-serif; letter-spacing: -2.8px; margin: 13px 0; }
.hero h1 span { color: #a5ff72; }
.hero p { margin: 0; color: #858585; font-size: 13px; }
.search-box { height: 48px; display: flex; align-items: center; gap: 12px; border: 1px solid #242424; background: #111; border-radius: 13px; padding: 0 14px; color: #858585; }
.search-box input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: white; font-size: 13px; }
.search-box input::placeholder { color: #686868; }
.clear-search { border: 0; background: transparent; color: #aaa; display: grid; place-items: center; }
.category-row { display: flex; overflow-x: auto; gap: 8px; padding: 17px 0 22px; scrollbar-width: none; }
.category-row::-webkit-scrollbar { display: none; }
.category-pill { white-space: nowrap; background: #101010; border: 1px solid #242424; color: #888; border-radius: 20px; padding: 9px 15px; font-size: 11px; }
.category-pill.selected { color: #080808; background: #a5ff72; border-color: #a5ff72; font-weight: 700; }
.section-heading { display: flex; align-items: end; justify-content: space-between; margin: 4px 0 16px; gap: 10px; }
.section-eyebrow { color: #858585; font-size: 9px; font-weight: 700; letter-spacing: 1.7px; }
.section-heading h2 { font: 700 21px 'Manrope', sans-serif; letter-spacing: -.7px; margin: 5px 0 0; }
.wallpaper-count { color: #666; font-size: 9px; letter-spacing: 1px; padding-bottom: 4px; white-space: nowrap; }
.wallpaper-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px 11px; }
.wallpaper-card { min-width: 0; }
.wallpaper-image-button { display: block; width: 100%; height: 205px; position: relative; border: 0; padding: 0; overflow: hidden; background: #151515; border-radius: 12px; text-align: left; }
.wallpaper-image-button img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s; }
.wallpaper-image-button:active img { transform: scale(1.04); }
.wallpaper-tag { position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,.65); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.1); padding: 5px 7px; border-radius: 5px; font-size: 8px; letter-spacing: .9px; font-weight: 700; }
.wallpaper-open { position: absolute; right: 9px; bottom: 9px; width: 27px; height: 27px; border-radius: 50%; display: grid; place-items: center; background: rgba(0,0,0,.6); }
.card-info { display: flex; align-items: center; justify-content: space-between; gap: 4px; padding: 10px 1px 0; }
.card-text { min-width: 0; }
.card-text h3 { font: 600 12px 'Manrope', sans-serif; margin: 0 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.card-text span { font-size: 10px; color: #767676; }
.card-actions { display: flex; gap: 2px; }
.card-action { border: 0; background: transparent; color: #8a8a8a; padding: 6px; display: grid; place-items: center; }
.card-action.liked, .preview-fav.liked { color: #a5ff72; }
.bottom-nav { position: fixed; z-index: 10; bottom: 0; left: 0; right: 0; max-width: 720px; margin: auto; background: rgba(8,8,8,.95); backdrop-filter: blur(20px); border-top: 1px solid #202020; padding: 11px 10px calc(10px + env(safe-area-inset-bottom)); display: flex; justify-content: space-around; }
.nav-item { border: 0; background: transparent; display: flex; flex-direction: column; align-items: center; gap: 5px; color: #777; font-size: 9px; min-width: 54px; }
.nav-item.active { color: #a5ff72; }
.empty-state { text-align: center; padding: 45px 20px; color: #777; }
.empty-icon { width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: #151515; margin: auto; color: #a5ff72; }
.empty-state h3 { color: white; margin: 17px 0 8px; }
.empty-state p { font-size: 12px; line-height: 1.6; }
.empty-button { background: #a5ff72; color: black; border: 0; border-radius: 25px; padding: 11px 17px; font-size: 12px; font-weight: 700; margin-top: 10px; }
.preview-overlay { position: fixed; inset: 0; z-index: 30; background: #000; }
.preview-panel { position: relative; width: 100%; height: 100%; }
.preview-image { width: 100%; height: 100%; object-fit: cover; display: block; }
.preview-panel::after { content: ''; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent,rgba(0,0,0,.85)); pointer-events: none; }
.preview-close { position: absolute; top: calc(18px + env(safe-area-inset-top)); left: 17px; z-index: 2; border: 0; background: rgba(0,0,0,.55); width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; }
.preview-bottom { position: absolute; bottom: calc(25px + env(safe-area-inset-bottom)); left: 20px; right: 20px; z-index: 2; }
.preview-info span { font-size: 10px; color: #a5ff72; letter-spacing: 1.5px; font-weight: 700; }
.preview-info h2 { font: 700 25px 'Manrope', sans-serif; margin: 8px 0 20px; }
.preview-buttons { display: flex; gap: 10px; }
.preview-fav { width: 52px; height: 52px; border: 1px solid #303030; border-radius: 14px; background: rgba(20,20,20,.8); display: grid; place-items: center; }
.preview-download { flex: 1; border: 0; border-radius: 14px; background: #a5ff72; color: #080808; display: flex; justify-content: center; align-items: center; gap: 9px; font-size: 13px; font-weight: 700; }
@media (min-width: 520px) {
  .wallpaper-image-button { height: 280px; }
}
@media (max-width: 360px) {
  .app-shell { padding-left: 12px; padding-right: 12px; }
  .wallpaper-image-button { height: 174px; }
  .hero h1 { font-size: 43px; }
}


/* WALLORA 2.0 Discovery controls */
.discovery-row {
  display: flex;
  gap: 9px;
  overflow-x: auto;
  padding: 0 0 14px;
  scrollbar-width: none;
}
.discovery-row::-webkit-scrollbar {
  display: none;
}
.discovery-pill {
  flex-shrink: 0;
  border: 1px solid #262626;
  background: #111;
  color: #909090;
  border-radius: 12px;
  padding: 11px 16px;
  font-size: 12px;
  font-weight: 600;
}
.discovery-pill.selected {
  color: #a5ff72;
  background: #151d10;
  border-color: #a5ff72;
}
